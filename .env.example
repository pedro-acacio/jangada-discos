# Copie para .env (local) ou configure em Vercel → Project → Settings →
# Environment Variables. Nenhum desses valores deve ir para o git.

# Mercado Pago — Access Token de PRODUÇÃO da conta da loja
# (Painel Mercado Pago → Seu negócio → Configurações → Credenciais)
MP_ACCESS_TOKEN=

# Melhor Envio — token da conta da loja + CEP de origem (o da loja)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_FROM_CEP=60000000
# "sandbox" para testar sem gerar frete real, ou vazio/"production" para valer
MELHOR_ENVIO_ENV=sandbox

# URL pública do site em produção (usada nos back_urls do Mercado Pago)
SITE_URL=https://jangadadiscos.com
